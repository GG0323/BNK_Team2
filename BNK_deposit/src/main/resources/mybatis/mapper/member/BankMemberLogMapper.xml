<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.bnk.dao.member.IMemberLogDao">

	<insert id="insertLog">
		INSERT INTO TB_MEMBER_TRACKING_LOG (
	        member_no,
	        requested_page,
	        request_method,
	        request_url,
	        request_ip
    		)
	    VALUES (
	        #{dto.memberNo},
	        #{dto.requestedPage},
	        #{dto.requestMethod},
	        #{dto.requestUrl},
	        #{dto.requestIp}
	    )
	</insert>
	
	<select id="allLog" resultType="com.example.bnk.dto.member.BankMemberLogDto">
		SELECT * FROM TB_MEMBER_TRACKING_LOG
	</select>

	<!-- <select id="findByUserID" resultType="">
		SELECT * FROM 
	</select> -->
</mapper>