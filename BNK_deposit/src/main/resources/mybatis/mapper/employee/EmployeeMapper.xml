    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.bnk.dao.employee.IEmployeeDao">
	<!-- TB_EMPLOYEE -->
	
	<!-- 로그인 인증 처리 id 검색 고민 반환을 전부 받을지, 아니면 pk랑, pw만 가져올지-->
	<select id="login" resultType="com.example.bnk.dto.employee.EmployeeDto">
		SELECT * FROM TB_EMPLOYEE 
		WHERE login_id = #{param}
	</select>
	
	
	
	
	
