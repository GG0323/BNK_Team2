<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.bnk.dao.product.IProductDetailResponseDao">

    <resultMap id="ProductDetailMap" type="com.example.bnk.dto.product.ProductDetailResponseDto">
        <association property="product" javaType="com.example.bnk.dto.product.ProductDto" autoMapping="true" />
        <association property="rate" javaType="com.example.bnk.dto.product.ProductRateDto" autoMapping="true" />
        <association property="description" javaType="com.example.bnk.dto.product.ProductDescriptionDto" autoMapping="true" />
        <association property="condition" javaType="com.example.bnk.dto.product.ProductConditionDto" autoMapping="true" />
    </resultMap>
	
    <select id="selectProductDetail" resultMap="ProductDetailMap" parameterType="long">
        SELECT *
        FROM TB_PRODUCT A
        LEFT JOIN TB_PRODUCT_RATE B        ON A.product_no = B.product_no       
        LEFT JOIN TB_PRODUCT_DESCRIPTION C ON A.product_no = C.product_no
        LEFT JOIN TB_PRODUCT_CONDITION D   ON A.product_no = D.product_no
        WHERE A.product_no = #{product_no}
    </select>

</mapper>